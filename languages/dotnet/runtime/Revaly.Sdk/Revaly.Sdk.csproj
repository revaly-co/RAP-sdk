<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Revaly.Sdk</RootNamespace>
    <AssemblyName>Revaly.Sdk</AssemblyName>
    <!-- Package identity is FINAL (ADR-SDK-030, runtime-tdd.md §7); publish stays
         embargoed until the flip runbook executes (repo rule 3, ADR-SDK-031). Version is
         a placeholder: stage 5 stamps real versions from per-language release tags. -->
    <PackageId>Revaly.Sdk</PackageId>
    <Version>0.0.0-dev</Version>
    <Description>Revaly RAP V2 server-side SDK for .NET — hand-written runtime over the generated core (ADR-SDK-001). Failover-safe typed errors, reconcile helper, values-free logging, mock transport.</Description>
    <Authors>Revaly</Authors>
    <Company>Revaly Technologies Inc.</Company>
    <Copyright>Copyright 2026 Revaly Technologies Inc.</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <!-- The quickstart README becomes the nuget.org gallery page. Without this the
         package ships with no documentation at all ("warn : Readme missing" on push),
         which is exactly the install-instruction gap the docs release set out to fix.
         The file is packed by the None item below; stage 5 stages the whole
         languages/dotnet tree via git archive, so ../../README.md resolves both in the
         repo and in the ephemeral packaging copy. -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/revaly-co/rap-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Packed at the package root to satisfy PackageReadmeFile above. Pack-only: it is
         not compiled, embedded, or copied to output. -->
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- The generated core (ADR-SDK-001: regenerated only, never hand-edited). It ships
         as its own package, Revaly.Sdk.Core, that this runtime package depends on
         (ADR-SDK-030; stage 5 packs both, stage 6 pushes core first). -->
    <ProjectReference Include="..\..\core\src\Revaly.Sdk.Core\Revaly.Sdk.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Versions aligned with the core's Microsoft.Extensions.* 10.0.1 set. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Revaly.Sdk.Tests" />
  </ItemGroup>

</Project>
