<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hand-written runtime module (runtime-tdd.md §§1-9) — the merchant-facing product layer
  wrapping the generated core. Registry identity co.revaly:revaly-sdk is FINAL (ADR-SDK-030,
  runtime-tdd §7); the version is a placeholder (stage 5 stamps releases). Publish is
  embargoed (repo rule 3) until the flip runbook executes (ADR-SDK-031).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>co.revaly</groupId>
    <artifactId>revaly-sdk</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>revaly-sdk</name>
    <description>RAP V2 Java SDK — hand-written runtime over the generated core (failover contract, reconcile helper, values-free logging, mock transport)</description>
    <url>https://github.com/revaly-co/rap-sdk</url>

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:git://github.com/revaly-co/rap-sdk.git</connection>
        <developerConnection>scm:git:ssh://github.com:revaly-co/rap-sdk.git</developerConnection>
        <url>https://github.com/revaly-co/rap-sdk</url>
    </scm>

    <!-- Maven Central rejects poms without a developers block (stage-6
         flip-readiness; the generated core pom already carries one). -->
    <developers>
        <developer>
            <name>Revaly SC Eng</name>
            <email>sdk@revaly.co</email>
            <organization>Revaly</organization>
            <organizationUrl>https://revaly.co</organizationUrl>
        </developer>
    </developers>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- release (not source/target) so JDK-21 CI builds cannot leak post-11 APIs. -->
        <maven.compiler.release>11</maven.compiler.release>
        <!-- Jackson floor matches the core's pinned 2.21.5 (pipeline/java/config.yaml
             pom.mustache fork rationale — Dependabot advisories). -->
        <jackson-version>2.22.2</jackson-version>
        <slf4j-version>2.0.17</slf4j-version>
        <!-- Ecosystem lint for the hand-written modules (DX contract §a) — Decided per
             ADR-SDK-028: spotless + google-java-format is the formatter, Error Prone with
             its default ERROR-severity checks is the linter (no custom bugpatterns, no
             config files). Never applied to core/ (ADR-SDK-001). -->
        <spotless-version>2.43.0</spotless-version>
        <google-java-format-version>1.17.0</google-java-format-version>
        <error-prone-version>2.50.0</error-prone-version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>co.revaly</groupId>
            <artifactId>revaly-sdk-core</artifactId>
            <version>0.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson-version}</version>
        </dependency>
        <!-- Ecosystem-native logging abstraction (runtime-tdd §6): the SDK logs through
             SLF4J and never binds an implementation — the merchant's binding decides. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j-version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <!-- Error Prone (ADR-SDK-028), default ERROR-severity checks only. The
                     compile is FORKED so the JDK-internal add-exports/add-opens flags
                     Error Prone needs on JDK 17+ ride the javac invocation itself (the
                     "-J" args below) — a .mvn/jvm.config would silently not load, because
                     CI invokes `mvn -f languages/java/pom.xml` from the repo root. -->
                <configuration>
                    <fork>true</fork>
                    <compilerArgs>
                        <arg>-XDcompilePolicy=simple</arg>
                        <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
                        <arg>--should-stop=ifError=FLOW</arg>
                        <arg>-Xplugin:ErrorProne</arg>
                        <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED</arg>
                        <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED</arg>
                        <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED</arg>
                        <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED</arg>
                        <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED</arg>
                        <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED</arg>
                        <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
                        <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
                    </compilerArgs>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>com.google.errorprone</groupId>
                            <artifactId>error_prone_core</artifactId>
                            <version>${error-prone-version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <!-- Implementation-Version in the jar manifest is what
                     RapUserAgent.resolveSemver() reports (ADR-SDK-005 telemetry).
                     It rides ${project.version}: 0.0.0-SNAPSHOT in dev builds,
                     the tag version once stage 5 stamps the release copy
                     (pipeline/package.sh). Classes-dir runs (surefire, IDEs)
                     still fall back to the 0.0.0 placeholder. -->
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <!-- Maven Central rejects bundles without sources + javadoc jars for every
                     artifact (stage-6 flip-readiness); versions match the generated core's
                     template. Doclint keeps reference/syntax checks but not the
                     missing-comment group — private members carry no doc comments. -->
                <artifactId>maven-source-plugin</artifactId>
                <version>3.2.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <doclint>all,-missing</doclint>
                    <quiet>true</quiet>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless-version}</version>
                <configuration>
                    <java>
                        <googleJavaFormat>
                            <version>${google-java-format-version}</version>
                            <style>AOSP</style>
                        </googleJavaFormat>
                        <removeUnusedImports/>
                    </java>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
