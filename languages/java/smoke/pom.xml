<?xml version="1.0" encoding="UTF-8"?>
<!--
  Stage-4 contract smoke module (ADR-SDK-024): a thin, live runtime-contract
  check against the environment in RAP_SMOKE_BASE_URL / RAP_SMOKE_API_KEY.
  Never deployed, never run by the unit-test stage — invoked explicitly via
  `mvn -pl smoke exec:java` from the stage-4 CI job.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>co.revaly</groupId>
    <artifactId>revaly-sdk-smoke</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>revaly-sdk-smoke</name>
    <description>RAP Java SDK stage-4 contract smoke (not a published artifact)</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>11</maven.compiler.release>
        <spotless-version>2.43.0</spotless-version>
        <google-java-format-version>1.17.0</google-java-format-version>
        <exec-maven-plugin-version>3.5.0</exec-maven-plugin-version>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>co.revaly</groupId>
            <artifactId>revaly-sdk</artifactId>
            <version>0.0.0-SNAPSHOT</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec-maven-plugin-version}</version>
                <configuration>
                    <mainClass>co.revaly.sdk.smoke.ContractSmoke</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless-version}</version>
                <configuration>
                    <java>
                        <googleJavaFormat>
                            <version>${google-java-format-version}</version>
                            <style>AOSP</style>
                        </googleJavaFormat>
                        <removeUnusedImports/>
                    </java>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
