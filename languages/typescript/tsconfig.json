{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "core/**/*.ts",
    "runtime/**/*.ts",
    "tests/**/*.ts",
    "smoke/**/*.ts",
    "vitest.config.ts",
    "vitest.smoke.config.ts"
  ]
}
