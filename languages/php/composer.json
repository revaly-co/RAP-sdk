{
    "name": "revaly/sdk",
    "description": "Revaly RAP SDK for PHP: hand-written runtime (typed failure classes, reconcile helper, values-free logging, mock transport) over the generated core.",
    "license": "Apache-2.0",
    "keywords": [
        "revaly",
        "rap",
        "payments",
        "sdk"
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/promises": "^1.5 || ^2.0",
        "guzzlehttp/psr7": "^1.7 || ^2.0",
        "psr/http-message": "^1.0 || ^2.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Revaly\\Sdk\\": "runtime/src/",
            "Revaly\\Sdk\\Core\\": "core/lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Revaly\\Sdk\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
