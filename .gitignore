# Toolchain installs — lockfiles are committed, installs are not
node_modules/

# Stage-2 local cache of the downloaded (and sha256-verified) spec artifact — the pin in
# spec/pin.yaml is the only committed spec reference (ADR-SDK-006)
.spec-work/

# Stage-3 build outputs — ephemeral in CI, disposable locally; nothing here is committed.
# composer.lock included: core/ is wiped on every regeneration (ADR-SDK-001), so a lockfile
# inside it could never survive — dependency floors live in the generated manifests
# (fixed via the pipeline template forks, never by editing core/).
languages/dotnet/**/bin/
languages/dotnet/**/obj/
languages/java/core/target/
languages/java/runtime/target/
languages/java/tests/target/
languages/java/smoke/target/
languages/php/core/vendor/
languages/php/core/composer.lock
languages/python/core/build/
languages/python/core/*.egg-info/
languages/python/build/
languages/python/*.egg-info/
languages/python/**/__pycache__/
languages/python/.pytest_cache/

# Stage-5 packaging output (pipeline/package.sh) — release assets are published as
# GitHub release artifacts (ADR-SDK-026), never committed.
dist/

# Stage-5 emitted TypeScript build (tsconfig.build.json) — exists only inside the
# packaging staging copy in CI; ignored here for local package.sh runs.
languages/typescript/dist/

# Go build output from running the smoke suite locally (`go build ./smoke`).
# Committing it once already cost a 10 MB blob — keep it ignored.
*.exe
